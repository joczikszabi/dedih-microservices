---
import Layout from "../layouts/Layout.astro";
---
<Layout title="Log in">
  <h1>Log in</h1>
  <form id="login" class="card" style="max-width: 360px">
    <label>E-mail <input name="email" value="alice@example.com" /></label>
    <label>Password <input name="password" type="password" value="alice123" /></label>
    <button>Log in</button>
    <p style="font-size: .85rem; color: #666">Test accounts: alice@example.com / alice123,
      bob@example.com / bob123, admin@example.com / admin123</p>
  </form>
  <div id="message"></div>
  <script type="module" is:inline>
    import { api, saveLogin } from "/shop.js";

    document.getElementById("login").onsubmit = async (event) => {
      event.preventDefault();
      const form = new FormData(event.target);
      const { ok, body } = await api("/api/orders/auth/login", {
        method: "POST",
        body: JSON.stringify({ email: form.get("email"), password: form.get("password") }),
      });
      if (ok) {
        saveLogin(body);
        location.href = "/";
      } else {
        document.getElementById("message").innerHTML =
          '<div class="message error">Wrong e-mail or password.</div>';
      }
    };
  </script>
</Layout>
